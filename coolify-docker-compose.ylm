
services:
  openviking:
    image: ghcr.io/volcengine/openviking:latest
    restart: unless-stopped

    expose:
      - "1933"

    volumes:
      - openviking_data:/app/.openviking

    environment:
      OPENVIKING_SERVER_PORT: "1933"
      OPENVIKING_PUBLIC_BASE_URL: ${OPENVIKING_PUBLIC_BASE_URL:-}
      OPENVIKING_GATEWAY_ENABLED: ${OPENVIKING_GATEWAY_ENABLED:-}
      OPENVIKING_GATEWAY_MANAGEMENT_KEY: ${OPENVIKING_GATEWAY_MANAGEMENT_KEY:-}
      OPENVIKING_GATEWAY_ENCRYPTION_KEY: ${OPENVIKING_GATEWAY_ENCRYPTION_KEY:-}

    healthcheck:
      test: ["CMD", "openviking-entrypoint", "--healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

volumes:
  openviking_data:
